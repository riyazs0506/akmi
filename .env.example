# Production origin, e.g. https://www.example.com (no trailing slash).
# Used for canonical URLs, Open Graph URLs, sitemap.xml and robots.txt at build time.
# Leave empty until the official domain is confirmed.
VITE_SITE_URL=

# Endpoint that receives enquiry form submissions as JSON (POST).
# Leave empty to keep the contact form in clearly-labelled demo mode.
VITE_ENQUIRY_ENDPOINT=
